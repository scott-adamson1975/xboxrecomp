    XS_WHEEL_FFB_SPRING,
    XS_WHEEL_FFB_SPEED,
    XS_WHEEL_FFB_REST,
    XS_WHEEL_FFB_RACE_ONLY,
    XS_WHEEL_FFB_AIR,
    XS_WHEEL_FFB_DRIFT,
    XS_WHEEL_RUMBLE,
